# Configuración de openQomu.
# Copia este archivo a `.env.local` y rellena solo lo que uses.
# Sin variables de Firebase la app arranca en modo local (datos en el navegador).

# --- Producto -------------------------------------------------------------
# Nombre visible. Cambiarlo rebautiza la instancia sin tocar el código.
VITE_PRODUCT_NAME=openQomu

# --- Firebase (opcional) --------------------------------------------------
# Firebase Console → Configuración del proyecto → Tus apps → Web.
# Con las seis variables la app usa Firestore, Auth y Storage de tu proyecto.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Fuerza el modo local aunque haya Firebase configurado.
VITE_DEMO_MODE=false
# Conecta Auth, Firestore y Storage a los emuladores locales.
VITE_USE_FIREBASE_EMULATORS=false

# --- Archivos -------------------------------------------------------------
# firestore: archivos pequeños (≤700 KB) sin coste y sin Worker.
# storage:   Firebase Storage (requiere plan Blaze).
# b2:        Worker de archivos con almacenamiento compatible con S3.
VITE_FILE_STORAGE=firestore
# Solo para VITE_FILE_STORAGE=b2. URL del Worker de archivos.
VITE_FILES_URL=

# --- Servicios opcionales -------------------------------------------------
# Servidor MCP de tu despliegue. Sin esta variable la sección IA se desactiva.
VITE_MCP_URL=
# Worker que entrega notificaciones push. Sin él la app funciona sin push.
VITE_PUSH_URL=

# --- Web y app nativa -----------------------------------------------------
# URL pública con la que se comparten enlaces. Obligatoria en el APK.
VITE_PUBLIC_APP_URL=
# Landing pública.
VITE_LANDING_URL=https://openqomu.web.app
# Hosts extra aceptados como App Links en Android, separados por comas.
VITE_APP_LINK_HOSTS=
# URL de la APK publicada por tu instancia. Si queda vacía, la app oculta la sección Android.
VITE_APK_URL=
# Client ID web de Google para el login nativo (Firebase → Auth → Google).
VITE_GOOGLE_WEB_CLIENT_ID=
