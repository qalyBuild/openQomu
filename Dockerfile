# syntax=docker/dockerfile:1
FROM node:22-alpine AS build
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

# Public configuration. Empty values produce a local-mode build.
ARG VITE_PRODUCT_NAME=openQomu
ARG VITE_FIREBASE_API_KEY=
ARG VITE_FIREBASE_AUTH_DOMAIN=
ARG VITE_FIREBASE_PROJECT_ID=
ARG VITE_FIREBASE_STORAGE_BUCKET=
ARG VITE_FIREBASE_MESSAGING_SENDER_ID=
ARG VITE_FIREBASE_APP_ID=
ARG VITE_FILE_STORAGE=firestore
ARG VITE_FILES_URL=
ARG VITE_PUSH_URL=
ARG VITE_MCP_URL=
ARG VITE_PUBLIC_APP_URL=
ARG VITE_APK_URL=

ENV VITE_PRODUCT_NAME=$VITE_PRODUCT_NAME \
    VITE_FIREBASE_API_KEY=$VITE_FIREBASE_API_KEY \
    VITE_FIREBASE_AUTH_DOMAIN=$VITE_FIREBASE_AUTH_DOMAIN \
    VITE_FIREBASE_PROJECT_ID=$VITE_FIREBASE_PROJECT_ID \
    VITE_FIREBASE_STORAGE_BUCKET=$VITE_FIREBASE_STORAGE_BUCKET \
    VITE_FIREBASE_MESSAGING_SENDER_ID=$VITE_FIREBASE_MESSAGING_SENDER_ID \
    VITE_FIREBASE_APP_ID=$VITE_FIREBASE_APP_ID \
    VITE_FILE_STORAGE=$VITE_FILE_STORAGE \
    VITE_FILES_URL=$VITE_FILES_URL \
    VITE_PUSH_URL=$VITE_PUSH_URL \
    VITE_MCP_URL=$VITE_MCP_URL \
    VITE_PUBLIC_APP_URL=$VITE_PUBLIC_APP_URL \
    VITE_APK_URL=$VITE_APK_URL

RUN npm run build

FROM nginx:1.27-alpine AS runtime
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=3s CMD wget -qO- http://127.0.0.1/ >/dev/null || exit 1
