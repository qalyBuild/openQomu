# Copia a `.dev.vars` para `npm run dev` en files-worker.
# En producción: `npx wrangler secret put <NOMBRE>`.

# JSON del service account con acceso a Firestore (una sola línea).
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_PROJECT_ID=

# Almacenamiento compatible con S3: Backblaze B2, Cloudflare R2, MinIO, Wasabi…
S3_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
S3_REGION=eu-central-003
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Cadena aleatoria larga; firma las URLs temporales de descarga.
FILE_URL_SECRET=cambia-este-valor-en-produccion

FILES_ALLOWED_ORIGINS=http://localhost:5173,https://localhost
