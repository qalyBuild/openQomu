{
  "name": "open-qomu",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:rules": "firebase emulators:exec --project demo-openqomu --only firestore \"vitest run --config vitest.rules.config.ts\"",
    "smoke": "node scripts/smoke.mjs",
    "interactions": "node scripts/interactions.mjs",
    "emulators": "firebase emulators:start",
    "skill:sync": "node scripts/sync-skill.mjs",
    "skill:check": "node scripts/sync-skill.mjs --check",
    "mcp:dev": "npm --prefix mcp-worker run dev",
    "mcp:deploy": "npm --prefix mcp-worker run deploy",
    "files:dev": "npm --prefix files-worker run dev",
    "files:deploy": "npm --prefix files-worker run deploy",
    "files:test": "npm --prefix files-worker test",
    "push:dev": "npm --prefix push-worker run dev",
    "push:deploy": "npm --prefix push-worker run deploy",
    "push:test": "npm --prefix push-worker test",
    "mobile:sync": "npm run build && npx cap sync android",
    "mobile:debug": "npm run mobile:sync && bash scripts/build-android.sh assembleDebug",
    "mobile:release": "npm run mobile:sync && bash scripts/build-android.sh assembleRelease",
    "deploy": "npm run build && firebase deploy --only hosting,firestore",
    "setup": "node scripts/setup.mjs",
    "check:private": "node scripts/check-no-private-values.mjs",
    "check:docs": "node scripts/check-doc-pairs.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.6.2",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@capgo/capacitor-social-login": "^8.7.11",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tiptap/extension-link": "^3.33.1",
    "@tiptap/extension-placeholder": "^3.33.1",
    "@tiptap/extension-task-item": "^3.33.1",
    "@tiptap/extension-task-list": "^3.33.1",
    "@tiptap/extension-underline": "^3.33.1",
    "@tiptap/pm": "^3.33.1",
    "@tiptap/react": "^3.33.1",
    "@tiptap/starter-kit": "^3.33.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "fflate": "^0.8.2",
    "firebase": "^13.3.0",
    "lucide-react": "^1.72.0",
    "motion": "^14.13.0",
    "qrcode.react": "^4.2.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.21.0",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.1.0",
    "firebase-tools": "^15.36.0",
    "jsdom": "^31.0.0",
    "oxlint": "^1.90.0",
    "playwright-core": "^1.65.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "description": "Espacio de trabajo colaborativo autoalojable: chat, Kanban, documentos y archivos en tiempo real.",
  "license": "AGPL-3.0-only"
}
