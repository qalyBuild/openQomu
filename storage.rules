rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Las rutas incluyen el workspace y un id no adivinable (UUID del documento).
    // Firestore y Storage son servicios separados: la pertenencia se refuerza
    // en las reglas de Firestore para los metadatos. Para aislamiento estricto
    // por membresía en Storage usa una Cloud Function de subida firmada.
    match /workspaces/{workspaceId}/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.size > 0
        && request.resource.size <= 25 * 1024 * 1024;
      allow delete: if request.auth != null;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
