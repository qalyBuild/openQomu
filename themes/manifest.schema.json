{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Qomu theme package manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "id", "version", "name", "author", "license", "variants"],
  "properties": {
    "formatVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "version": { "type": "integer", "minimum": 1, "maximum": 1000 },
    "name": { "type": "string", "minLength": 1, "maxLength": 60, "pattern": "\\S" },
    "author": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "\\S" },
    "license": { "type": "string", "minLength": 1, "maxLength": 60, "pattern": "\\S" },
    "description": { "type": "string", "minLength": 1, "maxLength": 300, "pattern": "\\S" },
    "variants": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "scheme", "file"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "scheme": { "enum": ["light", "dark"] },
          "file": { "type": "string", "pattern": "^variants/[a-z0-9][a-z0-9-]{1,39}\\.json$" },
          "wallpaper": { "type": "string", "pattern": "^assets/[a-z0-9][a-z0-9-]{0,63}\\.(png|jpe?g|webp)$" }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,39}$" }
  }
}
